rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function membershipDocId(ownerUid, memberUid) { return ownerUid + "_" + memberUid; }
    function isWorkspaceMember(ownerUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaceMembers/$(membershipDocId(ownerUid, request.auth.uid)));
    }
    function canAccessWorkspace(ownerUid) {
      return isSelf(ownerUid) || isWorkspaceMember(ownerUid);
    }

    // SEC-1 (BUDG-4): the membership id is bound to its fields, keys are allowlisted
    // and ownerUid/memberUid can never change, so nobody can forge {owner}_{me}.
    function notAnonymous() { return request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function memberKeys() {
      return ['ownerUid', 'ownerEmail', 'ownerName', 'memberUid', 'memberEmail', 'memberName',
              'role', 'status', 'createdAt', 'updatedAt'];
    }

    match /workspaceMembers/{membershipId} {
      allow create: if isSignedIn() && notAnonymous() &&
        request.resource.data.keys().hasOnly(memberKeys()) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUid is string &&
        request.resource.data.memberUid.size() > 0 &&
        request.resource.data.memberUid != request.auth.uid &&
        membershipId == membershipDocId(request.resource.data.ownerUid, request.resource.data.memberUid) &&
        request.resource.data.status == 'ACTIVE';
      allow read: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow update: if isSignedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(memberKeys()) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.memberUid == resource.data.memberUid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isOwner() { return isSignedIn() && request.auth.uid == resource.data.ownerId; }
    function creatingForSelf() {
      return isSignedIn() && request.auth.uid == request.resource.data.ownerId;
    }

    // Lock each user to their own subtree (if you store per-user docs here)
    match /users/{uid} {
      allow read, write: if canAccessWorkspace(uid);

      match /accounts/{accountId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /allocationDefaults/{defaultId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /settings/{settingsId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /periods/{periodId}/allocations/{allocationId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /{sub=**} {
        allow read, write: if canAccessWorkspace(uid);
      }
    }

    match /budgets/{budgetId} {
      allow create: if creatingForSelf();
      allow read, update, delete: if isOwner();
    }

    match /transactions/{txId} {
      allow create: if creatingForSelf();
      allow read, update, delete: if isOwner();
    }
  }
}
