rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    function membershipDocId(ownerUid, memberUid) { return ownerUid + "_" + memberUid; }
    function isWorkspaceMember(ownerUid) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaceMembers/$(membershipDocId(ownerUid, request.auth.uid)));
    }
    function canAccessWorkspace(ownerUid) {
      return isSelf(ownerUid) || isWorkspaceMember(ownerUid);
    }
    function isPublicShoppingList(ownerUid, listId) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/shoppingLists/$(listId)) &&
        get(/databases/$(database)/documents/users/$(ownerUid)/shoppingLists/$(listId)).data.visibility == 'PUBLIC';
    }
    function isWeeklyGroceriesShoppingList(ownerUid, listId) {
      return exists(/databases/$(database)/documents/users/$(ownerUid)/shoppingLists/$(listId)) &&
        get(/databases/$(database)/documents/users/$(ownerUid)/shoppingLists/$(listId)).data.name == 'Weekly Groceries';
    }
    function isReadablePublicShoppingList(ownerUid, listId) {
      return isPublicShoppingList(ownerUid, listId) || isWeeklyGroceriesShoppingList(ownerUid, listId);
    }
    function isPublicShoppingOwner(ownerUid) {
      return exists(/databases/$(database)/documents/publicShoppingOwners/$(ownerUid));
    }

    match /workspaceMembers/{membershipId} {
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.memberUid is string;
      allow read: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid || resource.data.memberUid == request.auth.uid);
      allow update, delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function isOwner() { return isSignedIn() && request.auth.uid == resource.data.ownerId; }
    function creatingForSelf() {
      return isSignedIn() && request.auth.uid == request.resource.data.ownerId;
    }

    match /publicShoppingLists/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid is string &&
        request.resource.data.listId is string &&
        (canAccessWorkspace(request.resource.data.ownerUid) ||
          isReadablePublicShoppingList(request.resource.data.ownerUid, request.resource.data.listId));
      allow update: if isSignedIn() &&
        resource.data.ownerUid is string &&
        resource.data.listId is string &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.listId == resource.data.listId &&
        (canAccessWorkspace(resource.data.ownerUid) ||
          isReadablePublicShoppingList(resource.data.ownerUid, resource.data.listId));
      allow delete: if isSignedIn() &&
        resource.data.ownerUid is string &&
        canAccessWorkspace(resource.data.ownerUid);
    }

    match /publicShoppingOwners/{ownerUid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.ownerUid == ownerUid &&
        request.resource.data.sourceListId is string &&
        (canAccessWorkspace(ownerUid) || isReadablePublicShoppingList(ownerUid, request.resource.data.sourceListId));
      allow delete: if isSignedIn() && canAccessWorkspace(ownerUid);
    }

    // Lock each user to their own subtree (if you store per-user docs here)
    match /users/{uid} {
      allow read, write: if canAccessWorkspace(uid);

      match /accounts/{accountId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /allocationDefaults/{defaultId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /settings/{settingsId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /periods/{periodId}/allocations/{allocationId} {
        allow read, write: if canAccessWorkspace(uid);
      }

      match /shoppingLists/{listId} {
        allow read: if canAccessWorkspace(uid) ||
          (isSignedIn() && (resource.data.visibility == 'PUBLIC' || resource.data.name == 'Weekly Groceries'));
        allow create, update, delete: if canAccessWorkspace(uid);

        match /items/{itemId} {
          allow read, write: if canAccessWorkspace(uid) ||
            (isSignedIn() && (isPublicShoppingList(uid, listId) || isWeeklyGroceriesShoppingList(uid, listId)));
        }
      }

      match /shoppingCatalog/{itemId} {
        allow read: if canAccessWorkspace(uid) || (isSignedIn() && isPublicShoppingOwner(uid));
        allow write: if canAccessWorkspace(uid);
      }

      match /{sub=**} {
        allow read, write: if canAccessWorkspace(uid);
      }
    }

    match /budgets/{budgetId} {
      allow create: if creatingForSelf();
      allow read, update, delete: if isOwner();
    }

    match /transactions/{txId} {
      allow create: if creatingForSelf();
      allow read, update, delete: if isOwner();
    }
  }
}
